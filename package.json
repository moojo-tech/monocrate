{
  "name": "monocrate",
  "version": "0.2.0",
  "description": "From monorepo to npm in one command",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "monocrate": "./dist/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" && eslint src tests",
    "lint:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" && eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "publish-to-npm": "./scripts/publish-to-npm.sh"
  },
  "keywords": [
    "monorepo",
    "npm",
    "bundler",
    "package",
    "publish"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moojo-tech/monocrate.git"
  },
  "bugs": {
    "url": "https://github.com/moojo-tech/monocrate/issues"
  },
  "homepage": "https://github.com/moojo-tech/monocrate#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.29",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.0.18",
    "@yarnpkg/cli-dist": "4.12.0",
    "bun": "^1.3.9",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "get-port": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "verdaccio": "^6.2.4",
    "vitest": "^4.0.18",
    "yarn": "1.22.22"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "esbuild": "^0.27.2",
    "tar": "^7.4.3",
    "tinyexec": "^1.0.2",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.5"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun",
      "esbuild"
    ]
  }
}
